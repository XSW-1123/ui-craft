/* ==========================================================================
   Design tokens
   Single source of truth. Nothing outside this file declares a raw value.
   Replace every <...> before use. Delete what the project does not need.
   ========================================================================== */

:root {
  color-scheme: light;

  /* ---- Color: primitives -------------------------------------------------
     The palette. Components never reference these directly.
     Prefer OKLCH so lightness steps stay perceptually even.               */
  --n-0:   #ffffff;
  --n-50:  #fafafa;
  --n-100: #f4f4f5;
  --n-200: #e4e4e7;
  --n-300: #d4d4d8;
  --n-400: #a1a1aa;
  --n-500: #71717a;   /* 4.6:1 on --n-50 — the muted-text floor */
  --n-600: #52525b;
  --n-700: #3f3f46;
  --n-800: #27272a;
  --n-900: #18181b;

  --brand-400: <#hex>;
  --brand-500: <#hex>;   /* the accent */
  --brand-600: <#hex>;   /* hover */
  --brand-700: <#hex>;   /* active */

  /* ---- Color: semantic ---------------------------------------------------
     What components actually use. 60 / 30 / 10.                            */
  --bg:            var(--n-50);
  --surface:       var(--n-0);
  --surface-sunk:  var(--n-100);
  --text:          var(--n-900);
  --text-muted:    var(--n-500);
  --text-inverse:  var(--n-0);
  --border:        var(--n-200);
  --border-strong: var(--n-400);   /* >= 3:1 — use when the border carries meaning */

  --accent:        var(--brand-500);
  --accent-hover:  var(--brand-600);
  --accent-active: var(--brand-700);
  --accent-fg:     var(--n-0);     /* MUST be >= 4.5:1 on --accent. Verify. */
  --accent-subtle: <#hex>;         /* tinted background for accent regions */

  /* Status — semantic only, never decorative.
     CN finance convention: rising = red, falling = green. */
  --success: #15803d;  --success-bg: #f0fdf4;
  --warning: #b45309;  --warning-bg: #fffbeb;
  --danger:  #b91c1c;  --danger-bg:  #fef2f2;
  --info:    #1d4ed8;  --info-bg:    #eff6ff;

  /* ---- Space: 4px base, mildly geometric --------------------------------
     4-8 within a group · 24-48 between groups · 64+ between sections       */
  --s-1: 4px;   --s-2: 8px;   --s-3: 12px;  --s-4: 16px;  --s-5: 24px;
  --s-6: 32px;  --s-7: 48px;  --s-8: 64px;  --s-9: 96px;  --s-10: 128px;

  /* ---- Type --------------------------------------------------------------
     One ratio (<1.25>), base 16px, rounded to integers.                     */
  --font-display: <"Display Family">, ui-serif, Georgia, serif;
  --font-text:    <"Text Family">, ui-sans-serif, system-ui, -apple-system,
                  "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-mono:    ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;

  --text-xs:   12px;
  --text-sm:   14px;
  --text-base: 16px;   /* never below this for body or inputs */
  --text-lg:   20px;
  --text-xl:   25px;
  --text-2xl:  31px;
  --text-3xl:  39px;
  --text-4xl:  clamp(2.5rem, 1.8rem + 3vw, 3.8rem);   /* display only */

  --leading-tight:  1.1;    /* display */
  --leading-snug:   1.35;   /* subheads */
  --leading-normal: 1.6;    /* body */
  --leading-cjk:    1.75;   /* CJK body needs more */

  --tracking-tight: -0.02em;  /* large display */
  --tracking-wide:  0.06em;   /* all-caps labels */

  --measure: 65ch;

  /* ---- Radius ------------------------------------------------------------ */
  --r-sm: 4px;  --r-md: 8px;  --r-lg: 16px;  --r-full: 999px;

  /* ---- Elevation: 3 levels, tinted, layered ------------------------------ */
  --shadow-1: 0 1px 2px rgb(16 16 20 / .06), 0 1px 1px rgb(16 16 20 / .04);
  --shadow-2: 0 4px 12px rgb(16 16 20 / .08), 0 1px 3px rgb(16 16 20 / .06);
  --shadow-3: 0 16px 48px rgb(16 16 20 / .12), 0 4px 12px rgb(16 16 20 / .08);

  /* ---- Motion ------------------------------------------------------------ */
  --dur-fast: 120ms;   /* hover, focus, toggles — seen constantly */
  --dur-base: 200ms;   /* dropdowns, tabs, tooltips */
  --dur-slow: 320ms;   /* modals, drawers, page transitions */

  --ease-out:    cubic-bezier(.2, 0, 0, 1);
  --ease-in:     cubic-bezier(.4, 0, 1, 1);
  --ease-in-out: cubic-bezier(.4, 0, .2, 1);
  --ease-spring: cubic-bezier(.34, 1.56, .64, 1);

  /* ---- Layout ------------------------------------------------------------ */
  --container: 1200px;
  --gutter: var(--s-5);
  --header-h: 64px;

  --z-dropdown: 1000;
  --z-sticky:   1020;
  --z-overlay:  1040;
  --z-modal:    1050;
  --z-toast:    1070;
}

/* ==========================================================================
   Dark theme — a separate design, not an inversion.
   Re-verify every contrast pair. Elevation moves from shadow to surface tint.
   ========================================================================== */

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) { color-scheme: dark; }
}

[data-theme="dark"],
:root:not([data-theme="light"]) {
  @media (prefers-color-scheme: dark) {
    --bg:            #0a0a0b;
    --surface:       #141416;
    --surface-sunk:  #08080a;
    --text:          #e8e8ea;
    --text-muted:    #9a9aa2;   /* verify >= 4.5:1 on --bg */
    --text-inverse:  #0a0a0b;
    --border:        rgb(255 255 255 / .08);
    --border-strong: rgb(255 255 255 / .22);

    --accent:        var(--brand-400);   /* usually needs +8-15% lightness */
    --accent-fg:     #0a0a0b;            /* often flips in dark mode */

    /* Shadows barely read on dark surfaces — lean on surface lightness. */
    --shadow-1: 0 1px 2px rgb(0 0 0 / .4);
    --shadow-2: 0 4px 12px rgb(0 0 0 / .5);
    --shadow-3: 0 16px 48px rgb(0 0 0 / .6);
  }
}

/* ==========================================================================
   Base — the minimum that makes the tokens actually apply.
   ========================================================================== */

*, *::before, *::after { box-sizing: border-box; }

html {
  -webkit-text-size-adjust: 100%;
  scroll-padding-top: calc(var(--header-h) + var(--s-4));
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-text);
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

h1, h2, h3, h4 {
  font-family: var(--font-display);
  line-height: var(--leading-tight);
  letter-spacing: var(--tracking-tight);
  text-wrap: balance;
  margin-block: var(--s-7) var(--s-3);   /* space above ~2x space below */
}

p, li { text-wrap: pretty; max-width: var(--measure); }

:where(:lang(zh), :lang(ja), :lang(ko)) body { line-height: var(--leading-cjk); }

/* Two-tone focus ring: survives both light and dark surfaces. */
:where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  box-shadow: 0 0 0 4px var(--bg);
  border-radius: var(--r-sm);
}

/* Expand touch targets without changing visual size. */
@media (pointer: coarse) {
  :where(a, button, [role="button"]) { min-height: 44px; min-width: 44px; }
}

img, video, svg { max-width: 100%; height: auto; }
img { background: var(--surface-sunk); }   /* avoids a white flash while loading */

table { border-collapse: collapse; }
td:where(.num), th:where(.num) {
  font-variant-numeric: tabular-nums;
  text-align: right;
}

::selection { background: var(--accent); color: var(--accent-fg); }

/* Reduced motion: strip transforms, keep state changes legible. */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
}
